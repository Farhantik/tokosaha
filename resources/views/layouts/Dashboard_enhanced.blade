                                        $textClass = 'text-orange-800 font-bold';
                                        $borderClass = 'border-2';
                                        $statusText = 'MENIPIS';
                                    } else {
                                        // Stok Rendah - Biru
                                        $badgeClass = 'bg-blue-100 border-blue-300';
                                        $iconClass = 'fas fa-info-circle text-blue-600';
                                        $textClass = 'text-blue-800 font-semibold';
                                        $borderClass = 'border';
                                        $statusText = 'PERLU RESTOCK';
                                    }
