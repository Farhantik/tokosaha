                                        $statusText = 'HABIS';
                                        $animate = 'animate-pulse';
                                    } elseif ($stok >= 1 && $stok <= 5) {
                                        // Stok Sangat Menipis - Merah
                                        $badgeClass = 'bg-red-100 border-red-300';
                                        $iconClass = 'fas fa-exclamation-triangle text-red-600';
                                        $textClass = 'text-red-800 font-bold';
                                        $borderClass = 'border-2';
                                        $statusText = 'SANGAT MENIPIS';
                                    } elseif ($stok >= 6 && $stok <= 10) {
                                        // Stok Menipis - Orange
