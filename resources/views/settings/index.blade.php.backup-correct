<script>
document.addEventListener('DOMContentLoaded', function() {
    console.log('Settings page loaded');
    
    // Get elements
    const scanBtn = document.getElementById('scanBtn');
    const testPrintBtn = document.getElementById('testPrintBtn');
    const saveBtn = document.getElementById('saveBtn');
    const printerSelect = document.getElementById('printer_name');
    const autoPrintToggle = document.getElementById('auto_print');
    
    // Scan Printer Button
    if (scanBtn) {
        scanBtn.addEventListener('click', async function() {
            console.log('🔍 Scan button clicked');
            
            try {
                const printers = await PrinterHelper.scanPrinters();
                
                // Clear and populate dropdown
                printerSelect.innerHTML = '<option value="">-- Pilih Printer --</option>';
                
                printers.forEach(function(printer) {
                    const option = document.createElement('option');
                    option.value = printer.id;
                    option.textContent = printer.name;
                    printerSelect.appendChild(option);
                });
                
                // Auto-select first printer
                if (printers.length > 0) {
                    printerSelect.value = printers[0].id;
                    alert('✅ Ditemukan ' + printers.length + ' printer');
                } else {
                    alert('⚠️ Tidak ada printer ditemukan');
                }
                
                console.log('✅ Scan completed:', printers);
                
            } catch (err) {
                console.error('❌ Scan error:', err);
                alert('Error scanning: ' + err.message);
            }
        });
    }
    
    // Test Print Button
    if (testPrintBtn) {
        testPrintBtn.addEventListener('click', function() {
            console.log('🖨️ Test Print clicked');
            
            try {
                PrinterHelper.testPrint();
            } catch (err) {
                console.error('❌ Test print error:', err);
                alert('Error test print: ' + err.message);
            }
        });
    }
    
    // Save Settings Button
    if (saveBtn) {
        saveBtn.addEventListener('click', function() {
            console.log('💾 Save button clicked');
            
            const settings = {
                printerName: printerSelect.value,
                autoPrint: autoPrintToggle.checked,
                paperWidth: document.getElementById('paper_width').value,
                fontSize: document.getElementById('font_size').value
            };
            
            console.log('Saving settings:', settings);
            
            if (!settings.printerName) {
                alert('⚠️ Pilih printer terlebih dahulu!');
                return;
            }
            
            // Save to PrinterHelper
            const saved = PrinterHelper.saveSettings(settings);
            
            if (saved) {
                alert('✅ Pengaturan berhasil disimpan!');
            } else {
                alert('❌ Gagal menyimpan pengaturan');
            }
        });
    }
    
    // Load saved settings on page load
    const savedSettings = localStorage.getItem('printerSettings');
    if (savedSettings) {
        try {
            const data = JSON.parse(savedSettings);
            if (data.printerName) {
                printerSelect.value = data.printerName;
            }
            if (data.autoPrint !== undefined) {
                autoPrintToggle.checked = data.autoPrint;
            }
            console.log('✅ Loaded saved settings:', data);
        } catch (err) {
            console.error('Error loading settings:', err);
        }
    }
});
</script>

