<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    // Load settings from localStorage
    function loadSettings() {
        const settings = JSON.parse(localStorage.getItem('printerSettings') || '{}');
        
        if (settings.autoPrint) {
            document.getElementById('autoPrintToggle').classList.add('active');
        }
        
        if (settings.selectedPrinter) {
            document.getElementById('printerSelect').value = settings.selectedPrinter;
            updatePrinterStatus(true);
        }
        
        if (settings.paperWidth) {
            document.getElementById('paperWidth').value = settings.paperWidth;
        }
        
        if (settings.fontSize) {
            document.getElementById('fontSize').value = settings.fontSize;
        }
    }

    // Toggle auto print
    function toggleAutoPrint() {
        const toggle = document.getElementById('autoPrintToggle');
        toggle.classList.toggle('active');
        
        const settings = JSON.parse(localStorage.getItem('printerSettings') || '{}');
        settings.autoPrint = toggle.classList.contains('active');
        localStorage.setItem('printerSettings', JSON.stringify(settings));
        
        Swal.fire({
            toast: true,
            position: 'top-end',
            icon: 'success',
            title: settings.autoPrint ? 'Auto Print diaktifkan' : 'Auto Print dinonaktifkan',
            showConfirmButton: false,
            timer: 2000
        });
    }

    // Scan for printers
    async function scanPrinters() {
        const btn = event.target.closest('button');
        const originalHtml = btn.innerHTML;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Scanning...';
        btn.disabled = true;

        try {
            // Check if Web USB API is available
            if (!navigator.usb) {
                throw new Error('Browser tidak mendukung Web USB API. Gunakan Chrome atau Edge terbaru.');
            }

            // Request USB device
            const device = await navigator.usb.requestDevice({
                filters: [
                    { classCode: 7 } // Printer class
                ]
            });

            const select = document.getElementById('printerSelect');
            select.innerHTML = '<option value="">-- Pilih Printer --</option>';
            
            const option = document.createElement('option');
            option.value = device.serialNumber || 'thermal-printer-1';
            option.text = `${device.productName || 'Thermal Printer'} (${device.manufacturerName || 'Unknown'})`;
            option.selected = true;
            select.appendChild(option);

            updatePrinterStatus(true);

            Swal.fire({
                icon: 'success',
                title: 'Printer Ditemukan!',
                text: `${option.text} berhasil terdeteksi`,
                confirmButtonColor: '#10b981',
                customClass: {
                    popup: 'rounded-2xl',
                    confirmButton: 'px-6 py-3 rounded-xl font-semibold'
                },
                buttonsStyling: false
            });

        } catch (error) {
            console.error('Error scanning printers:', error);
            
            // Fallback: Add manual printer options
            const select = document.getElementById('printerSelect');
            select.innerHTML = `
                <option value="">-- Pilih Printer --</option>
                <option value="thermal-58mm">Thermal Printer 58mm</option>
                <option value="thermal-80mm">Thermal Printer 80mm</option>
                <option value="pos-printer">POS Thermal Printer</option>
                <option value="bluetooth-printer">Bluetooth Thermal Printer</option>
            `;
            
            Swal.fire({
                icon: 'info',
                title: 'Pilih Manual',
                html: `
                    <p class="text-gray-600 mb-3">${error.message || 'Tidak dapat mendeteksi printer otomatis'}</p>
                    <p class="text-sm text-gray-500">Silakan pilih jenis printer Anda dari dropdown</p>
                `,
                confirmButtonColor: '#10b981',
                customClass: {
                    popup: 'rounded-2xl',
                    confirmButton: 'px-6 py-3 rounded-xl font-semibold'
                },
                buttonsStyling: false
            });
        } finally {
            btn.innerHTML = originalHtml;
            btn.disabled = false;
        }
    }

    // Update printer status
    function updatePrinterStatus(connected) {
        const statusText = document.getElementById('printerStatusText');
        const statusBadge = document.getElementById('printerStatusBadge');
        
        if (connected) {
            statusText.textContent = 'Terhubung';
            statusBadge.className = 'printer-status connected';
            statusBadge.innerHTML = '<i class="fas fa-circle mr-2 text-xs"></i>Online';
        } else {
            statusText.textContent = 'Tidak Terhubung';
            statusBadge.className = 'printer-status disconnected';
            statusBadge.innerHTML = '<i class="fas fa-circle mr-2 text-xs"></i>Offline';
        }
    }

    // Printer select change
    document.getElementById('printerSelect').addEventListener('change', function() {
        updatePrinterStatus(this.value !== '');
    });

    // Test print
    function testPrint() {
        const printer = document.getElementById('printerSelect').value;
        
        if (!printer) {
            Swal.fire({
                icon: 'warning',
                title: 'Pilih Printer',
                text: 'Silakan pilih printer terlebih dahulu',
                confirmButtonColor: '#10b981',
                customClass: {
                    popup: 'rounded-2xl',
                    confirmButton: 'px-6 py-3 rounded-xl font-semibold'
                },
                buttonsStyling: false
            });
            return;
        }

        // Create test receipt
        const testReceipt = {
            toko_nama: 'TOKO SAHABAT',
            toko_alamat: 'Jl. Test Print No. 123',
            toko_telp: '0812-3456-7890',
            id_penjualan: 'TEST-001',
            tanggal: new Date().toLocaleDateString('id-ID'),
            waktu: new Date().toLocaleTimeString('id-ID'),
            kasir: '{{ Auth::user()->name }}',
            items: [
                { nama_produk: 'Test Item 1', qty: 2, harga: 10000 },
                { nama_produk: 'Test Item 2', qty: 1, harga: 15000 }
            ],
            total: 35000,
            bayar: 50000,
            kembalian: 15000
        };

        if (typeof window.printReceipt === 'function') {
            window.printReceipt(testReceipt, true);
        } else {
            alert('Fungsi printReceipt tidak tersedia. Pastikan printer-helper.js sudah dimuat.');
        }
    }

    // Save settings
    function saveSettings() {
        const settings = {
            selectedPrinter: document.getElementById('printerSelect').value,
            paperWidth: document.getElementById('paperWidth').value,
            fontSize: document.getElementById('fontSize').value,
            autoPrint: document.getElementById('autoPrintToggle').classList.contains('active')
        };

        if (!settings.selectedPrinter) {
            Swal.fire({
                icon: 'warning',
                title: 'Pilih Printer',
                text: 'Silakan pilih printer terlebih dahulu',
                confirmButtonColor: '#10b981',
                customClass: {
                    popup: 'rounded-2xl',
                    confirmButton: 'px-6 py-3 rounded-xl font-semibold'
                },
                buttonsStyling: false
            });
            return;
        }

        localStorage.setItem('printerSettings', JSON.stringify(settings));

        Swal.fire({
            icon: 'success',
            title: 'Pengaturan Disimpan!',
            text: 'Pengaturan printer berhasil disimpan',
            confirmButtonColor: '#10b981',
            customClass: {
                popup: 'rounded-2xl',
                confirmButton: 'px-6 py-3 rounded-xl font-semibold'
            },
            buttonsStyling: false
        });
    }

    // Load settings on page load
    loadSettings();
</script>
