<script>
// Global wrappers for onclick handlers
function scanPrinters() {
    console.log("🔍 scanPrinters called");
    if (window.PrinterHelper) return PrinterHelper.scanPrinters();
    alert("PrinterHelper not ready");
}

function testPrint() {
    console.log("🖨️ testPrint called");
    if (window.PrinterHelper) return PrinterHelper.testPrint();
    alert("PrinterHelper not ready");
}

// Global variable untuk status auto print
let autoPrintEnabled = false;

// Function untuk toggle (dipanggil dari onclick HTML)
function toggleAutoPrint() {
    autoPrintEnabled = !autoPrintEnabled;
    console.log('Auto Print toggled:', autoPrintEnabled);
    
    // Update visual toggle
    const toggle = document.getElementById('autoPrintToggle');
    if (toggle) {
        if (autoPrintEnabled) {
            toggle.classList.add('active');
        } else {
            toggle.classList.remove('active');
        }
    }
    
    // Save to localStorage
    const currentSettings = JSON.parse(localStorage.getItem('printerSettings') || '{}');
    currentSettings.autoPrint = autoPrintEnabled;
    localStorage.setItem('printerSettings', JSON.stringify(currentSettings));
}

document.addEventListener('DOMContentLoaded', function() {
    console.log('✅ Settings page loaded');
    
    // Get elements with correct IDs
    const scanBtn = document.getElementById('scanBtn');
    const testPrintBtn = document.getElementById('testPrintBtn');
    const saveBtn = document.getElementById('saveBtn');
    const printerSelect = document.getElementById('printerSelect');
    const autoPrintToggle = document.getElementById('autoPrintToggle');
    
    console.log('Elements found:', {
        scanBtn: !!scanBtn,
        testPrintBtn: !!testPrintBtn,
        saveBtn: !!saveBtn,
        printerSelect: !!printerSelect,
        autoPrintToggle: !!autoPrintToggle
    });
    
    // Scan Printer
    if (scanBtn) {
        scanBtn.addEventListener('click', async function(e) {
            e.preventDefault();
            console.log('🔍 Scanning printers...');
            
            try {
                const printers = await PrinterHelper.scanPrinters();
                
                if (printerSelect) {
                    printerSelect.innerHTML = '<option value="">-- Pilih Printer --</option>';
                    
                    printers.forEach(printer => {
                        const option = document.createElement('option');
                        option.value = printer.id;
                        option.textContent = printer.name;
                        printerSelect.appendChild(option);
                    });
                    
                    if (printers.length > 0) {
                        printerSelect.value = printers[0].id;
                    }
                }
                
                alert('✅ Ditemukan ' + printers.length + ' printer');
                console.log('✅ Scan completed:', printers);
                
            } catch (err) {
                console.error('❌ Scan error:', err);
                alert('Error: ' + err.message);
            }
        });
    }
    
    // Test Print
    if (testPrintBtn) {
        testPrintBtn.addEventListener('click', function(e) {
            e.preventDefault();
            console.log('🖨️ Testing printer...');
            
            try {
                PrinterHelper.testPrint();
            } catch (err) {
                console.error('❌ Test print error:', err);
                alert('Error: ' + err.message);
            }
        });
    }
    
    // Save Settings
    if (saveBtn) {
        saveBtn.addEventListener('click', function(e) {
            e.preventDefault();
            console.log('💾 Saving settings...');
            
            const printerName = printerSelect ? printerSelect.value : '';
            
            if (!printerName) {
                alert('⚠️ Pilih printer terlebih dahulu!');
                return;
            }
            
            const settings = {
                printerName: printerName,
                autoPrint: autoPrintEnabled,
                paperWidth: '80mm',
                fontSize: 'Sedang',
                timestamp: new Date().toISOString()
            };
            
            console.log('Settings to save:', settings);
            
            const saved = PrinterHelper.saveSettings(settings);
            
            if (saved) {
                alert('✅ Pengaturan berhasil disimpan!');
                console.log('✅ Settings saved successfully');
            } else {
                alert('❌ Gagal menyimpan pengaturan');
            }
        });
    }
    
    // Load saved settings
    try {
        const savedSettings = localStorage.getItem('printerSettings');
        if (savedSettings) {
            const data = JSON.parse(savedSettings);
            console.log('📦 Loading saved settings:', data);
            
            // Restore printer selection
            if (printerSelect && data.printerName) {
                setTimeout(() => {
                    printerSelect.value = data.printerName;
                    console.log('✅ Printer selected:', data.printerName);
                }, 100);
            }
            
            // Restore auto print toggle
            if (data.autoPrint !== undefined) {
                autoPrintEnabled = data.autoPrint;
                if (autoPrintToggle && autoPrintEnabled) {
                    autoPrintToggle.classList.add('active');
                }
                console.log('✅ Auto print restored:', autoPrintEnabled);
            }
        }
    } catch (err) {
        console.warn('⚠️ Could not load settings:', err.message);
    }
});
</script>

@push('scripts')
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
