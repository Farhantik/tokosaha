    <script>

        async function openThermalPrinter() {
            console.log('🖨️ Direct Print');

            try {
                const printerStatus = localStorage.getItem('thermal_printer_status');
                
                if (!printerStatus) {
                    alert('⚠️ Printer belum dikonfigurasi!\n\nBuka: Menu → Settings');
                    return;
                }

                const printer = JSON.parse(printerStatus);
                console.log('📱 Printer:', printer.printerName);

                const receiptData = {
                    id: '{{ str_pad($penjualan->id_penjualan, 6, "0", STR_PAD_LEFT) }}',
                    tanggal: '{{ date("d/m/Y H:i", strtotime($penjualan->tanggal_penjualan)) }}',
                    kasir: '{{ $penjualan->kasir }}',
                    total: {{ $penjualan->total_bayar }},
                    tunai: {{ $penjualan->total_pembayaran }},
                    kembalian: {{ $penjualan->kembalian_pembayaran }},
                    items: [
                        @foreach($detail as $item)
                        {
                            nama: '{{ addslashes($item->nama_produk) }}',
                            qty: {{ $item->qty_produk }},
                            harga: {{ $item->harga_produk }},
                            subtotal: {{ $item->subtotal_harga }}
                        },
                        @endforeach
                    ]
                };

                let device = null;

                try {
                    const devices = await navigator.bluetooth.getDevices();
                    device = devices.find(d => d.name === printer.printerName || d.name?.includes('RPP02N'));
                    
                    if (device) {
                        console.log('✅ Using paired:', device.name);
                    } else {
                        throw new Error('Not found');
                    }
                } catch (err) {
                    console.log('⚠️ Requesting device...');
                    device = await navigator.bluetooth.requestDevice({
                        filters: [
                            { services: ['000018f0-0000-1000-8000-00805f9b34fb'] },
                            { namePrefix: 'RPP02N' }
                        ],
                        optionalServices: ['000018f0-0000-1000-8000-00805f9b34fb']
                    });
                }

                if (!device.gatt.connected) await device.gatt.connect();
                
                const service = await device.gatt.getPrimaryService('000018f0-0000-1000-8000-00805f9b34fb');
                const char = await service.getCharacteristic('00002af1-0000-1000-8000-00805f9b34fb');

                const ESC = 0x1B, GS = 0x1D;
                await char.writeValue(new Uint8Array([ESC, 0x40]));
                await new Promise(r => setTimeout(r, 100));

                async function print(txt, align = 0, bold = false) {
                    if (bold) await char.writeValue(new Uint8Array([ESC, 0x45, 1]));
                    await char.writeValue(new Uint8Array([ESC, 0x61, align]));
                    await char.writeValue(new TextEncoder().encode(txt + '\n'));
                    await char.writeValue(new Uint8Array([ESC, 0x61, 0]));
                    if (bold) await char.writeValue(new Uint8Array([ESC, 0x45, 0]));
                    await new Promise(r => setTimeout(r, 50));
                }

                await print('TOKO SAHABAT', 1, true);
                await print('Jl. Wonorejo, Rungkut', 1);
                await print('Surabaya', 1);
                await print('Telp: 081234567890', 1);
                await print('================================', 1);
                await print(`No: ${receiptData.id}`);
                await print(`Tgl: ${receiptData.tanggal}`);
                await print(`Kasir: ${receiptData.kasir}`);
                await print('================================');
                
                for (const i of receiptData.items) {
                    await print(i.nama);
                    const line = `${i.qty} x Rp ${i.harga.toLocaleString('id-ID')}`;
                    const sub = `Rp ${i.subtotal.toLocaleString('id-ID')}`;
                    await print(line + ' '.repeat(Math.max(1, 32 - line.length - sub.length)) + sub);
                }
                
                await print('================================');
                await print('TOTAL', 0, true);
                await print(`Rp ${receiptData.total.toLocaleString('id-ID')}`, 2, true);
                await print(`Tunai: Rp ${receiptData.tunai.toLocaleString('id-ID')}`);
                await print(`Kembalian: Rp ${receiptData.kembalian.toLocaleString('id-ID')}`);
                await print('================================');
                await print('Terima Kasih', 1);
                await print('', 1);
                
                await char.writeValue(new Uint8Array([GS, 0x56, 0x41, 0x03]));
                
                console.log('✅ Done!');
                alert('✅ Struk berhasil dicetak!');
                
            } catch (err) {
                console.error('❌ Error:', err);
                alert('❌ Gagal!\n\n' + err.message);
            }
        }


        // Auto focus untuk print
        window.addEventListener('keydown', function(e) {
            if (e.ctrlKey && e.key === 'p') {
                e.preventDefault();
                window.print();
            }
        });

        // Function untuk cetak thermal
    </script>
