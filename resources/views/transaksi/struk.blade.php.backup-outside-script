function openThermalPrinter() {
    console.log('🖨️ Direct Print dari Struk');

    // Cek printer
    const printerStatus = localStorage.getItem('thermal_printer_status');
    
    if (!printerStatus) {
        alert('⚠️ Printer belum dikonfigurasi!\n\nBuka: Menu → Settings → Scan & pilih printer → Simpan');
        return;
    }

    const printer = JSON.parse(printerStatus);
    
    if (!printer.connected || !printer.printerName) {
        alert('⚠️ Printer belum terhubung!\n\nSilakan hubungkan printer di Settings');
        return;
    }

    if (!navigator.bluetooth) {
        alert('❌ Browser tidak support Bluetooth!\n\nGunakan Chrome/Edge/Opera');
        return;
    }

    console.log('🔌 Printer:', printer.printerName);

    // Data transaksi dengan FIELD YANG BENAR
    const receiptData = {
        id: '{{ str_pad($penjualan->id_penjualan, 6, "0", STR_PAD_LEFT) }}',
        tanggal: '{{ date("d/m/Y H:i", strtotime($penjualan->tanggal_penjualan)) }}',
        kasir: '{{ $penjualan->kasir }}',
        total: {{ $penjualan->total_bayar }},
        tunai: {{ $penjualan->total_pembayaran }},
        kembalian: {{ $penjualan->kembalian_pembayaran }},
        items: [
            @foreach($detail as $item)
            {
                nama: '{{ addslashes($item->nama_produk) }}',
                qty: {{ $item->qty_produk }},
                harga: {{ $item->harga_produk }},
                subtotal: {{ $item->subtotal_harga }}
            },
            @endforeach
        ]
    };

    console.log('📄 Data struk:', receiptData);

    // Connect ke Bluetooth printer
    navigator.bluetooth.requestDevice({
        filters: [
            { namePrefix: 'RPP02N' },
            { namePrefix: 'ALGOO' },
            { namePrefix: 'BlueTooth Printer' },
            { namePrefix: 'Printer' }
        ],
        optionalServices: [
            '000018f0-0000-1000-8000-00805f9b34fb',
            '0000fee0-0000-1000-8000-00805f9b34fb',
            '49535343-fe7d-4ae5-8fa9-9fafd205e455'
        ]
    })
    .then(device => {
        console.log('🔌 Connecting to:', device.name);
        return device.gatt.connect();
    })
    .then(server => {
        console.log('✅ GATT Connected');
        return server.getPrimaryService('000018f0-0000-1000-8000-00805f9b34fb')
            .catch(() => server.getPrimaryService('49535343-fe7d-4ae5-8fa9-9fafd205e455'))
            .catch(() => server.getPrimaryService('0000fee0-0000-1000-8000-00805f9b34fb'));
    })
    .then(service => {
        console.log('✅ Service found');
        return service.getCharacteristic('00002af1-0000-1000-8000-00805f9b34fb')
            .catch(() => service.getCharacteristic('49535343-8841-43f4-a8d4-ecbe34729bb3'))
            .catch(() => service.getCharacteristic('0000fee1-0000-1000-8000-00805f9b34fb'));
    })
    .then(characteristic => {
        console.log('✅ Characteristic found - Building receipt...');
        
        // ESC/POS Commands
        const cmd = [];
        
        // Initialize printer
        cmd.push(0x1B, 0x40); // ESC @
        
        // Center align + Bold
        cmd.push(0x1B, 0x61, 0x01); // Center
        cmd.push(0x1B, 0x45, 0x01); // Bold ON
        cmd.push(...new TextEncoder().encode('TOKO SAHABAT\n'));
        cmd.push(0x1B, 0x45, 0x00); // Bold OFF
        
        // Store info
        cmd.push(...new TextEncoder().encode('Jl. Merdeka, Bungkus\n'));
        cmd.push(...new TextEncoder().encode('Surabaya\n'));
        cmd.push(...new TextEncoder().encode('Telp: 0512345678\n\n'));
        
        // Left align
        cmd.push(0x1B, 0x61, 0x00);
        
        // Transaction details
        cmd.push(...new TextEncoder().encode('No.      : #' + receiptData.id + '\n'));
        cmd.push(...new TextEncoder().encode('Tanggal  : ' + receiptData.tanggal + '\n'));
        cmd.push(...new TextEncoder().encode('Kasir    : ' + receiptData.kasir + '\n'));
        cmd.push(...new TextEncoder().encode('================================\n'));
        
        // Items
        receiptData.items.forEach(item => {
            cmd.push(...new TextEncoder().encode(item.nama + '\n'));
            const line = item.qty + ' x Rp ' + item.harga.toLocaleString('id-ID') + 
                        ' = Rp ' + item.subtotal.toLocaleString('id-ID') + '\n';
            cmd.push(...new TextEncoder().encode(line));
        });
        
        // Totals
        cmd.push(...new TextEncoder().encode('================================\n'));
        cmd.push(...new TextEncoder().encode('TOTAL    Rp ' + receiptData.total.toLocaleString('id-ID') + '\n'));
        cmd.push(...new TextEncoder().encode('Tunai    Rp ' + receiptData.tunai.toLocaleString('id-ID') + '\n'));
        cmd.push(...new TextEncoder().encode('Kembali  Rp ' + receiptData.kembalian.toLocaleString('id-ID') + '\n\n'));
        
        // Center footer
        cmd.push(0x1B, 0x61, 0x01);
        cmd.push(...new TextEncoder().encode('Terima Kasih\n'));
        cmd.push(...new TextEncoder().encode('Atas Kunjungan Anda\n\n'));
        
        // Cut paper
        cmd.push(0x1D, 0x56, 0x00);
        
        // Feed paper
        cmd.push(0x0A, 0x0A, 0x0A);
        
        console.log('📤 Sending ' + cmd.length + ' bytes to printer...');
        return characteristic.writeValue(new Uint8Array(cmd));
    })
    .then(() => {
        console.log('✅ Print berhasil!');
        alert('✅ Struk berhasil dicetak ke ' + printer.printerName + '!');
    })
    .catch(err => {
        console.error('❌ Print error:', err);
        alert('❌ Gagal mencetak!\n\n' + err.message + '\n\nPastikan:\n1. Printer dalam keadaan ON\n2. Printer dalam jangkauan Bluetooth\n3. Bluetooth device aktif');
    });
}



