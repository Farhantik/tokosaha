    <script>

        // Global variable untuk cached device
        let cachedBluetoothDevice = null;

        async function openThermalPrinter() {
            console.log('🖨️ Auto Print - No Popup');
            
            const btn = event.target;
            const originalText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '⏳ Connecting...';

            try {
                // Cek printer config
                const printerStatus = localStorage.getItem('thermal_printer_status');
                if (!printerStatus) {
                    alert('⚠️ Printer belum dikonfigurasi!\n\nBuka: Menu → Settings → Scan printer');
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                    return;
                }

                const printer = JSON.parse(printerStatus);
                console.log('📱 Target:', printer.printerName);

                // Coba gunakan cached device dulu
                let device = cachedBluetoothDevice;
                
                if (!device || !device.gatt.connected) {
                    console.log('🔍 Getting paired devices...');
                    
                    // Coba ambil dari getDevices() (device yang sudah paired)
                    try {
                        const devices = await navigator.bluetooth.getDevices();
                        device = devices.find(d => 
                            d.name === printer.printerName || 
                            d.name.includes('RPP') || 
                            d.name.includes('ALGOO')
                        );
                        
                        if (device) {
                            console.log('✅ Found paired device:', device.name);
                            cachedBluetoothDevice = device;
                        }
                    } catch (e) {
                        console.log('⚠️ getDevices() not supported or no paired devices');
                    }
                }

                // Kalau belum ada paired device, request sekali
                if (!device) {
                    console.log('🔍 Requesting device (first time only)...');
                    device = await navigator.bluetooth.requestDevice({
                        filters: [
                            { name: printer.printerName },
                            { namePrefix: 'RPP' },
                            { namePrefix: 'ALGOO' }
                        ],
                        optionalServices: ['000018f0-0000-1000-8000-00805f9b34fb']
                    });
                    cachedBluetoothDevice = device;
                    console.log('✅ Device paired:', device.name);
                }

                btn.innerHTML = '⏳ Connecting GATT...';

                // Connect ke GATT
                if (!device.gatt.connected) {
                    await device.gatt.connect();
                    console.log('✅ GATT connected');
                }

                const service = await device.gatt.getPrimaryService('000018f0-0000-1000-8000-00805f9b34fb');
                const characteristic = await service.getCharacteristic('00002af1-0000-1000-8000-00805f9b34fb');
                
                console.log('✅ Ready to print');
                btn.innerHTML = '🖨️ Printing...';

                // Receipt data
                const receiptData = {
                    store: 'TOKO SAHABAT',
                    address: 'Jl. Raya Contoh No. 123, Surabaya',
                    phone: 'Tel: (031) 1234567',
                    transaction: '{{ $penjualan->id_penjualan }}',
                    date: '{{ \Carbon\Carbon::parse($penjualan->tanggal_penjualan)->format("d/m/Y H:i") }}',
                    cashier: '{{ $penjualan->kasir }}',
                    items: [
                        @foreach($detail as $item)
                        {
                            name: '{{ $item->nama_produk }}',
                            qty: {{ $item->qty_produk }},
                            price: {{ $item->harga_produk }},
                            subtotal: {{ $item->subtotal_harga }}
                        },
                        @endforeach
                    ],
                    subtotal: {{ $penjualan->total_bayar }},
                    discount: 0,
                    total: {{ $penjualan->total_bayar }},
                    payment: {{ $penjualan->total_pembayaran }},
                    change: {{ $penjualan->kembalian_pembayaran }}
                };

                // Build ESC/POS receipt
                const ESC = '\x1B';
                const GS = '\x1D';
                
                let receipt = ESC + '@'; // Initialize
                receipt += ESC + 'a' + '\x01'; // Center
                receipt += ESC + '!' + '\x30'; // Double size
                receipt += receiptData.store + '\n';
                receipt += ESC + '!' + '\x00'; // Normal
                receipt += receiptData.address + '\n';
                receipt += receiptData.phone + '\n';
                receipt += ESC + 'a' + '\x00'; // Left align
                receipt += '================================\n';
                receipt += 'No: ' + receiptData.transaction + '\n';
                receipt += 'Tgl: ' + receiptData.date + '\n';
                receipt += 'Kasir: ' + receiptData.cashier + '\n';
                receipt += '================================\n';

                // Items
                receiptData.items.forEach(item => {
                    receipt += item.name + '\n';
                    receipt += '  ' + item.qty + ' x ' + item.price.toLocaleString('id-ID') + '\n';
                    const sub = item.subtotal.toLocaleString('id-ID');
                    receipt += ' '.repeat(32 - sub.length) + sub + '\n';
                });

                receipt += '================================\n';
                receipt += 'Subtotal:' + ' '.repeat(23 - receiptData.subtotal.toLocaleString('id-ID').length) + receiptData.subtotal.toLocaleString('id-ID') + '\n';
                receipt += 'Diskon:' + ' '.repeat(25 - receiptData.discount.toLocaleString('id-ID').length) + receiptData.discount.toLocaleString('id-ID') + '\n';
                receipt += '================================\n';
                receipt += ESC + '!' + '\x30'; // Double
                receipt += 'TOTAL:' + ' '.repeat(20 - receiptData.total.toLocaleString('id-ID').length) + receiptData.total.toLocaleString('id-ID') + '\n';
                receipt += ESC + '!' + '\x00'; // Normal
                receipt += '================================\n';
                receipt += 'Bayar:' + ' '.repeat(26 - receiptData.payment.toLocaleString('id-ID').length) + receiptData.payment.toLocaleString('id-ID') + '\n';
                receipt += 'Kembali:' + ' '.repeat(24 - receiptData.change.toLocaleString('id-ID').length) + receiptData.change.toLocaleString('id-ID') + '\n';
                receipt += '================================\n';
                receipt += ESC + 'a' + '\x01'; // Center
                receipt += 'Terima Kasih\n';
                receipt += 'Selamat Berbelanja\n\n';
                receipt += GS + 'V' + '\x00'; // Cut paper

                // Send to printer
                const encoder = new TextEncoder();
                await characteristic.writeValue(encoder.encode(receipt));
                
                console.log('✅ Print successful!');
                btn.innerHTML = '✅ Tercetak!';
                
                setTimeout(() => {
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                }, 2000);

            } catch (error) {
                console.error('❌ Error:', error);
                btn.innerHTML = originalText;
                btn.disabled = false;

                let msg = 'Gagal mencetak!\n\n';
                if (error.message.includes('User cancelled')) {
                    msg = 'Pencetakan dibatalkan';
                } else if (error.message.includes('GATT')) {
                    msg += '❌ Koneksi gagal!\n\nPastikan:\n1. Printer ON\n2. Bluetooth aktif\n3. Dalam jangkauan\n\n💡 Coba unpair & pair ulang di Settings';
                } else {
                    msg += error.message;
                }
                alert(msg);
            }
        }

        // Bluetooth Thermal Printer Function

        // Bluetooth connection state
        let btDevice = null;
        let btCharacteristic = null;


